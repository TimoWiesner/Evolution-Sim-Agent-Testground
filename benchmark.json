{
  "benchmark_version": 2,
  "runs_root": "~/evo-runs",
  "max_cycles": 3,
  "recovery_attempts": 1,
  "max_run_seconds": 172800,
  "max_limit_wait_seconds": 21600,
  "max_refusals_in_a_row": 6,
  "infra_retry_waits_seconds": [60, 300, 900, 1800],
  "max_cost_usd": null,
  "max_tokens": null,
  "benchmark_test_timeout_seconds": 180,
  "min_free_disk_gb": 10,
  "git_author_name": "Evolution Benchmark",
  "git_author_email": "benchmark@localhost",
  "container": {
    "runtime": "podman",
    "image": "evo-bench:1",
    "cpus": null,
    "memory": "16g"
  },
  "eval": {
    "path": "../Evolution-Sim-Agent-Eval",
    "timeout_seconds": 5400
  },
  "results": {
    "path": "../Evolution-Sim-Agent-Results"
  },
  "clis": {
    "claude": { "executable": "claude" },
    "codex": { "executable": "codex" },
    "opencode": { "executable": "opencode" }
  },
  "defaults": {
    "model": null,
    "phase_timeout_seconds": 1800,
    "max_turns": null,
    "extra_args": [],
    "env": {},
    "host_ports": [], "workers": 3
  },
  "profiles": {
    "claude-fable": { "cli": "claude", "model": "fable" },
    "claude-opus": { "cli": "claude", "model": "opus" },
    "claude-sonnet": { "cli": "claude", "model": "sonnet" },
    "claude-haiku": { "cli": "claude", "model": "haiku" },
    "gpt-luna": { "cli": "codex", "model": "gpt-6-luna" },
    "gpt-terra": { "cli": "codex", "model": "gpt-6.1-terra" },
    "gpt-sol": { "cli": "codex", "model": "gpt-6.1-sol" },
    "gpt-astra": { "cli": "codex", "model": "gpt-6-astra" },
    "local-qwen": {
      "cli": "opencode",
      "model": "llama.cpp/qwen3.6-35b-a3b",
      "phase_timeout_seconds": 7200,
      "host_ports": [8080], "workers": 1
    }
  }
}
