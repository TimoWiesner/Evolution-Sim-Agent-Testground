# Agent sandbox image for the Evolution Agent Benchmark.
# Build with: python3 run.py build-image
# The agent CLIs are NOT installed here; the harness mounts the host's binaries read-only,
# so the container always runs the CLI versions recorded in run.json.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo \
    PLAYWRIGHT_BROWSERS_PATH=/opt/browsers \
    CHROME_BIN=/usr/local/bin/chromium \
    PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chromium \
    PATH=/opt/rust/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git openssh-client less unzip zip xz-utils \
        build-essential pkg-config cmake \
        python3 python3-pip python3-venv python3-dev python3-tk \
        nodejs npm \
        ripgrep jq procps \
        xvfb xauth libgl1 libegl1 libxkbcommon0 libfontconfig1 libdbus-1-3 \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable --component clippy,rustfmt \
    && chmod -R a+rwX /opt/rust

# Headless Chromium for browser UIs (smoke test and screenshots). Ubuntu 24.04 only ships Chromium
# as a snap, which does not work in a container, so Playwright's build is used. `chromium` is a
# wrapper that adds --no-sandbox, which Chromium needs when it runs as root in a container.
RUN npx -y playwright@1.49.1 install --with-deps chromium \
    && chrome="$(find /opt/browsers -type f -name chrome | head -n 1)" && test -x "$chrome" \
    && printf '#!/bin/sh\nexec "%s" --no-sandbox "$@"\n' "$chrome" > /usr/local/bin/chromium \
    && chmod 755 /usr/local/bin/chromium && chmod -R a+rX /opt/browsers \
    && rm -rf /root/.npm /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["sleep", "infinity"]
